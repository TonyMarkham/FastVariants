.fv-variant-editor {
    padding-top: 6px;
    padding-right: 2px;
    padding-bottom: 8px;
    padding-left: 2px;
}

.fv-header {
    margin-bottom: 8px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    border-left-width: 3px;
    border-left-color: rgb(80, 160, 255);
    background-color: rgba(80, 160, 255, 0.12);
}

.fv-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.fv-subtitle,
.fv-note {
    color: rgb(166, 176, 190);
    white-space: normal;
}

.fv-section {
    margin-top: 6px;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.03);
}

.fv-section-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.fv-note {
    margin-top: 4px;
    font-size: 11px;
}

.fv-primary-button {
    margin-top: 4px;
    margin-bottom: 8px;
    height: 24px;
    -unity-font-style: bold;
}

.fv-foldout {
    padding-top: 4px;
}

.fv-generated-field {
    opacity: 0.85;
}
