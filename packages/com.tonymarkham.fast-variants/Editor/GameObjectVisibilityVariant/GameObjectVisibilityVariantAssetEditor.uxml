<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="fv-variant-editor">
        <ui:VisualElement class="fv-header">
            <ui:Label text="GameObject Visibility Variant" class="fv-title" />
            <ui:Label text="Configure the identity and target object used to generate this visibility variant." class="fv-subtitle" />
        </ui:VisualElement>

        <ui:VisualElement class="fv-section">
            <ui:Label text="Identity" class="fv-section-title" />
            <uie:PropertyField binding-path="m_ItemName" label="Name" />
            <uie:PropertyField binding-path="m_ItemCode" label="Code" />
        </ui:VisualElement>

        <ui:VisualElement class="fv-section">
            <ui:Label text="Visibility Target" class="fv-section-title" />
            <uie:PropertyField binding-path="m_ItemGameObject" label="Target GameObject" />
            <ui:VisualElement name="target-gameobject-drop-zone" class="fv-drop-zone">
                <ui:Label text="Drop Target Here" class="fv-drop-zone-title" />
                <ui:Label name="target-drop-zone-status" text="Drop a prefab asset, or a scene prefab instance child. The matching Project prefab GameObject will be assigned." class="fv-drop-zone-status" />
            </ui:VisualElement>
            <uie:PropertyField binding-path="m_GameObjectVisibilityVariantSet" label="Variant Set" />
            <ui:Label text="The target GameObject must expose a valid Entity Id for this variant to be valid." class="fv-note" />
        </ui:VisualElement>

        <ui:Foldout text="Generated Data" value="false" class="fv-section fv-foldout">
            <uie:PropertyField name="item-is-valid" binding-path="m_ItemIsValid" label="Is Valid" class="fv-generated-field" />
            <uie:PropertyField name="variant" binding-path="m_GameObjectVisibilityVariant" label="Variant" class="fv-generated-field" />
            <uie:PropertyField name="protobuf" binding-path="m_Protobuf" label="Protobuf" class="fv-generated-field" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
